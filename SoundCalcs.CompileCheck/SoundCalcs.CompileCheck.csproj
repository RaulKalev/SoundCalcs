<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Compile-only check of the whole plugin (Revit + WPF code included) on Linux.
    The Linux .NET SDK cannot build UseWPF projects, so this compiles every plugin
    .cs file against reference assemblies from NuGet (Revit API, WindowsDesktop.App.Ref,
    SkiaSharp.Views.WPF, ...) with the XAML-generated members stubbed in XamlStubs.cs.
    XAML itself is not compiled and nothing here is meant to run.

      dotnet build SoundCalcs.CompileCheck -p:EnableWindowsTargeting=true
  -->
  <PropertyGroup>
    <TargetFrameworks>net8.0-windows;net48</TargetFrameworks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <OutputType>Library</OutputType>
    <NoWarn>CA1416;CS0649;CS0169;CS0414</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../**/*.cs"
             Exclude="../SoundCalcs.Tests/**;../SoundCalcs.Harness/**;../SoundCalcs.CompileCheck/**;../**/obj/**;../**/bin/**" />
    <Compile Include="XamlStubs.cs" />
  </ItemGroup>

  <!-- Same packages as SoundCalcs.csproj -->
  <ItemGroup>
    <PackageReference Include="MaterialDesignColors" Version="5.2.1" />
    <PackageReference Include="MaterialDesignThemes" Version="5.2.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="ricaun.Revit.UI" Version="0.7.1" />
    <PackageReference Include="SkiaSharp" Version="2.88.8" />
    <PackageReference Include="SkiaSharp.Views.WPF" Version="2.88.8" />
  </ItemGroup>

  <!-- Revit 2024 (.NET Framework 4.8) -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Nice3point.Revit.Api.AdWindows" Version="2024.3.30" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2024.3.30" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2024.3.30" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <!-- Revit 2026 (.NET 8) -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <PackageReference Include="Nice3point.Revit.Api.AdWindows" Version="2026.4.0" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2026.4.0" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2026.4.0" />
    <PackageDownload Include="Microsoft.WindowsDesktop.App.Ref" Version="[8.0.0]" />
  </ItemGroup>

  <Target Name="AddWindowsDesktopReferences" BeforeTargets="ResolveAssemblyReferences"
          Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <ItemGroup>
      <Reference Include="$(NuGetPackageRoot)microsoft.windowsdesktop.app.ref/8.0.0/ref/net8.0/*.dll" />
    </ItemGroup>
  </Target>

</Project>
