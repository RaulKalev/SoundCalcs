<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net48;net8.0-windows</TargetFrameworks>
    <AssemblyName>SoundCalcs</AssemblyName>
    <RootNamespace>SoundCalcs</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NoWarn>CA1416</NoWarn>
    <LangVersion>latest</LangVersion>
    <!-- libSkiaSharp is embedded in the plugin DLL (Costura on net48, EmbeddedResource on net8); suppress SkiaSharp's default Content copy -->
    <ShouldIncludeNativeSkiaSharp>False</ShouldIncludeNativeSkiaSharp>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\SoundCalcs.tiff" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="SoundCalcs.Tests\**" />
    <EmbeddedResource Remove="SoundCalcs.Tests\**" />
    <None Remove="SoundCalcs.Tests\**" />
    <Page Remove="SoundCalcs.Tests\**" />
    <Compile Remove="SoundCalcs.Harness\**" />
    <EmbeddedResource Remove="SoundCalcs.Harness\**" />
    <None Remove="SoundCalcs.Harness\**" />
    <Page Remove="SoundCalcs.Harness\**" />
    <Compile Remove="SoundCalcs.CompileCheck\**" />
    <EmbeddedResource Remove="SoundCalcs.CompileCheck\**" />
    <None Remove="SoundCalcs.CompileCheck\**" />
    <Page Remove="SoundCalcs.CompileCheck\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Fody" Version="6.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Costura.Fody" Version="6.0.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="MaterialDesignColors" Version="5.2.1" />
    <PackageReference Include="MaterialDesignThemes" Version="5.2.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="ricaun.Revit.UI" Version="0.7.1" />
    <PackageReference Include="SkiaSharp" Version="2.88.8" />
    <PackageReference Include="SkiaSharp.Views.WPF" Version="2.88.8" />
  </ItemGroup>

  <!-- Revit 2024 (NET 4.8) -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Nice3point.Revit.Api.AdWindows" Version="2024.3.30" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2024.3.30" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2024.3.30" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Data.DataSetExtensions" />
  </ItemGroup>

  <!-- Revit 2026 (NET 8.0) -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <PackageReference Include="Nice3point.Revit.Api.AdWindows" Version="2026.4.0" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2026.4.0" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2026.4.0" />
    <!-- Embed native libSkiaSharp (Costura only embeds unmanaged DLLs on net48); App extracts and loads it at startup -->
    <EmbeddedResource Include="$(NuGetPackageRoot)skiasharp.nativeassets.win32\2.88.8\runtimes\win-x64\native\libSkiaSharp.dll">
      <LogicalName>SoundCalcs.Native.libSkiaSharp.dll</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Release output is the single plugin DLL: symbols embedded, no deps.json (dependencies are embedded too) -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>embedded</DebugType>
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
    <Resource Include="Assets\SoundCalcs.tiff" />
  </ItemGroup>

  <!-- Inject native libSkiaSharp.dll into ReferenceCopyLocalPaths so Costura.Fody can find and embed it as an unmanaged resource -->
  <Target Name="AddNativeSkiaForCostura" BeforeTargets="FodyTarget" Condition="'$(TargetFramework)' == 'net48'">
    <ItemGroup>
      <ReferenceCopyLocalPaths Include="$(NuGetPackageRoot)skiasharp.nativeassets.win32\2.88.8\runtimes\win-x64\native\libSkiaSharp.dll" />
    </ItemGroup>
  </Target>

</Project>
