<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        SoundCalcs design tokens, the same as Sentinel's (theme independent). Colours live in DarkTheme / LightTheme;
        ThemeManager builds the high-contrast palette from the system colours.

        Type scale (DIPs)      Caption 11 · Secondary 12 · Body 13 · Emphasis 14 · Section 15 · Title 20
        Spacing scale          2 · 4 · 8 · 12 · 16 · 24 · 32   (all margins/paddings come from this scale)
        Radii                  Small 4 (chips, focus inset) · Control 6 · Card 10 · Floating 12 · Window 12
        Control height         32 (dense Revit workflow; toolbar 32, list rows 36, sheet buttons 32)
    -->

    <!--  Fonts: the platform system font (Segoe UI Variable on Windows 11, Segoe UI on Windows 10)  -->
    <FontFamily x:Key="Font.Text">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Display">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas</FontFamily>

    <sys:Double x:Key="FontSize.Caption">11</sys:Double>
    <sys:Double x:Key="FontSize.Secondary">12</sys:Double>
    <sys:Double x:Key="FontSize.Body">13</sys:Double>
    <sys:Double x:Key="FontSize.Emphasis">14</sys:Double>
    <sys:Double x:Key="FontSize.Section">15</sys:Double>
    <sys:Double x:Key="FontSize.Title">20</sys:Double>

    <!--  Sizes  -->
    <sys:Double x:Key="Size.Control">32</sys:Double>
    <sys:Double x:Key="Size.ControlSmall">28</sys:Double>
    <sys:Double x:Key="Size.Row">36</sys:Double>
    <sys:Double x:Key="Size.Icon">16</sys:Double>
    <sys:Double x:Key="Size.IconButton">28</sys:Double>

    <!--  Radii  -->
    <CornerRadius x:Key="Radius.Small">4</CornerRadius>
    <CornerRadius x:Key="Radius.Control">6</CornerRadius>
    <CornerRadius x:Key="Radius.Card">10</CornerRadius>
    <CornerRadius x:Key="Radius.Floating">12</CornerRadius>
    <CornerRadius x:Key="Radius.Window">12</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">14</CornerRadius>

    <!--  Spacing (Thickness helpers on the 4-pt grid)  -->
    <Thickness x:Key="Pad.Control">12,0,12,0</Thickness>
    <Thickness x:Key="Pad.Card">16,14,16,14</Thickness>
    <Thickness x:Key="Pad.Section">16,12,16,12</Thickness>
    <Thickness x:Key="Pad.Page">16,12,16,12</Thickness>
    <Thickness x:Key="Gap.Right.S">0,0,8,0</Thickness>
    <Thickness x:Key="Gap.Right.M">0,0,12,0</Thickness>
    <Thickness x:Key="Gap.Bottom.XS">0,0,0,4</Thickness>
    <Thickness x:Key="Gap.Bottom.S">0,0,0,8</Thickness>
    <Thickness x:Key="Gap.Bottom.M">0,0,0,12</Thickness>
    <Thickness x:Key="Gap.Bottom.L">0,0,0,16</Thickness>
    <Thickness x:Key="Gap.Top.S">0,8,0,0</Thickness>
    <Thickness x:Key="Gap.Top.M">0,12,0,0</Thickness>

    <!--  Motion (used by Motion.cs; honours "Show animations in Windows")  -->
    <Duration x:Key="Motion.Fast">0:0:0.12</Duration>
    <Duration x:Key="Motion.Panel">0:0:0.18</Duration>

</ResourceDictionary>
