<Window
    x:Class="SoundCalcs.UI.ReportWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
    Title="SoundCalcs report"
    Width="1320"
    Height="880"
    MinWidth="1000"
    MinHeight="620"
    Background="{DynamicResource Window.Background}"
    ShowInTaskbar="False"
    TextOptions.TextFormattingMode="Display"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterOwner">
    <!--
        Report dialog: areas and rooms on the left (like the rooms of a lighting report), what to include, criteria
        and project details in the middle, and the pages exactly as they will print on the right.
    -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--  Palette + materials are inserted at runtime by ThemeManager; styles use DynamicResource  -->
                <ResourceDictionary Source="pack://application:,,,/SoundCalcs;component/UI/Themes/DarkTheme.xaml" />
                <ResourceDictionary Source="pack://application:,,,/SoundCalcs;component/UI/Themes/SoundCalcsStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="PageScroll" TargetType="{x:Type ScrollViewer}">
                <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Padding" Value="0,0,10,0" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid
        Margin="24,16,24,16"
        TextElement.FontFamily="{StaticResource Font.Text}"
        TextElement.FontSize="{StaticResource FontSize.Body}"
        TextElement.Foreground="{DynamicResource Text.Primary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" MinWidth="240" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="400" MinWidth="320" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" MinWidth="300" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="5" Margin="0,0,0,12">
            <TextBlock Style="{StaticResource Type.Title}" Text="PDF report" />
            <TextBlock
                Margin="0,2,0,0"
                Style="{StaticResource Type.Secondary}"
                Text="Tick the areas and rooms to include, choose the contents and criteria, check the pages on the right and save." />
        </StackPanel>

        <!--  ================= Areas and rooms =================  -->
        <DockPanel Grid.Row="1">
            <TextBlock
                DockPanel.Dock="Top"
                Style="{StaticResource Type.GroupTitle}"
                Text="Areas and rooms" />
            <StackPanel Margin="0,10,0,0" DockPanel.Dock="Bottom">
                <Button
                    HorizontalAlignment="Left"
                    Click="Calculate_Click"
                    IsEnabled="{Binding CanCalculate}"
                    Style="{StaticResource Button.Secondary}"
                    ToolTip="Run the areas that are not calculated or changed since (Full quality)">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="PlaylistPlay" Style="{StaticResource ButtonIconLabel}" />
                        <TextBlock Text="{Binding CalculateLabel}" />
                    </StackPanel>
                </Button>
                <StackPanel Margin="0,8,0,0" Visibility="{Binding Main.IsRunningAll, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource Type.Caption}" Text="{Binding Main.RunAllProgress}" />
                    <ProgressBar
                        Margin="0,4,0,0"
                        AutomationProperties.Name="Calculation progress"
                        Maximum="1"
                        Minimum="0"
                        Style="{StaticResource Progress.Bar}"
                        Value="{Binding Main.Progress, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>
            <Border Padding="4,6" Style="{StaticResource Card}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Areas}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="6,4,6,8">
                                    <DockPanel>
                                        <materialDesign:PackIcon
                                            x:Name="StatusGlyph"
                                            Width="14"
                                            Height="14"
                                            Margin="0,3,6,0"
                                            VerticalAlignment="Top"
                                            DockPanel.Dock="Right"
                                            Foreground="{DynamicResource Text.Tertiary}"
                                            Kind="CircleOutline"
                                            ToolTip="{Binding StatusText}" />
                                        <CheckBox
                                            IsChecked="{Binding IsChecked}"
                                            IsEnabled="{Binding HasResults}"
                                            Style="{StaticResource Input.Check}">
                                            <StackPanel>
                                                <TextBlock
                                                    Style="{StaticResource Type.RowLabel}"
                                                    Text="{Binding Name}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock Style="{StaticResource Type.RowHint}" Text="{Binding StatusText}" />
                                            </StackPanel>
                                        </CheckBox>
                                    </DockPanel>
                                    <ItemsControl Margin="26,4,0,0" ItemsSource="{Binding Rooms}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,2">
                                                    <TextBlock
                                                        x:Name="OutcomeText"
                                                        Margin="8,0,6,0"
                                                        VerticalAlignment="Center"
                                                        DockPanel.Dock="Right"
                                                        Style="{StaticResource Type.Caption}"
                                                        Text="{Binding Outcome}" />
                                                    <CheckBox IsChecked="{Binding IsChecked}" Style="{StaticResource Input.Check}">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Style="{StaticResource Type.Caption}" Text="{Binding Summary}" />
                                                        </StackPanel>
                                                    </CheckBox>
                                                </DockPanel>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Passed}" Value="True">
                                                        <Setter TargetName="OutcomeText" Property="Foreground" Value="{DynamicResource Status.Ok}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Failed}" Value="True">
                                                        <Setter TargetName="OutcomeText" Property="Foreground" Value="{DynamicResource Status.Error}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                        <Setter TargetName="StatusGlyph" Property="Kind" Value="CheckCircle" />
                                        <Setter TargetName="StatusGlyph" Property="Foreground" Value="{DynamicResource Status.Ok}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsOutdated}" Value="True">
                                        <Setter TargetName="StatusGlyph" Property="Kind" Value="AlertCircle" />
                                        <Setter TargetName="StatusGlyph" Property="Foreground" Value="{DynamicResource Status.Warning}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </DockPanel>

        <!--  ================= Options =================  -->
        <ScrollViewer
            x:Name="OptionsScroll"
            Grid.Row="1"
            Grid.Column="2"
            Style="{StaticResource PageScroll}">
            <StackPanel Margin="0,0,0,16">
                <TextBlock Style="{StaticResource Type.GroupTitle}" Text="Project" />
                <Border Padding="0,2" Style="{StaticResource Card}">
                    <StackPanel>
                                <DockPanel Style="{StaticResource SettingRow}">
                                    <TextBox
                                        Width="220"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="Project"
                                        DockPanel.Dock="Right"
                                        Style="{StaticResource Input.Text}"
                                        Text="{Binding Info.ProjectName, UpdateSourceTrigger=PropertyChanged}" />
                                    <StackPanel Style="{StaticResource SettingText}">
                                        <TextBlock Style="{StaticResource Type.RowLabel}" Text="Project" />
                                        <TextBlock Style="{StaticResource Type.RowHint}" Text="Name on the cover and in the page header" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DockPanel>
                                <Rectangle Style="{StaticResource Hairline}" />
                                <DockPanel Style="{StaticResource SettingRow}">
                                    <TextBox
                                        Width="220"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="Project number"
                                        DockPanel.Dock="Right"
                                        Style="{StaticResource Input.Text}"
                                        Text="{Binding Info.ProjectNumber, UpdateSourceTrigger=PropertyChanged}" />
                                    <StackPanel Style="{StaticResource SettingText}">
                                        <TextBlock Style="{StaticResource Type.RowLabel}" Text="Project number" />
                                    </StackPanel>
                                </DockPanel>
                                <Rectangle Style="{StaticResource Hairline}" />
                                <DockPanel Style="{StaticResource SettingRow}">
                                    <TextBox
                                        Width="220"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="Client"
                                        DockPanel.Dock="Right"
                                        Style="{StaticResource Input.Text}"
                                        Text="{Binding Info.Client, UpdateSourceTrigger=PropertyChanged}" />
                                    <StackPanel Style="{StaticResource SettingText}">
                                        <TextBlock Style="{StaticResource Type.RowLabel}" Text="Client" />
                                    </StackPanel>
                                </DockPanel>
                                <Rectangle Style="{StaticResource Hairline}" />
                                <DockPanel Style="{StaticResource SettingRow}">
                                    <TextBox
                                        Width="220"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="Company"
                                        DockPanel.Dock="Right"
                                        Style="{StaticResource Input.Text}"
                                        Text="{Binding Info.Company, UpdateSourceTrigger=PropertyChanged}" />
                                    <StackPanel Style="{StaticResource SettingText}">
                                        <TextBlock Style="{StaticResource Type.RowLabel}" Text="Company" />
                                    </StackPanel>
                                </DockPanel>
                                <Rectangle Style="{StaticResource Hairline}" />
                                <DockPanel Style="{StaticResource SettingRow}">
                                    <TextBox
                                        Width="220"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="Prepared by"
                                        DockPanel.Dock="Right"
                                        Style="{StaticResource Input.Text}"
                                        Text="{Binding Info.Author, UpdateSourceTrigger=PropertyChanged}" />
                                    <StackPanel Style="{StaticResource SettingText}">
                                        <TextBlock Style="{StaticResource Type.RowLabel}" Text="Prepared by" />
                                    </StackPanel>
                                </DockPanel>
                                <Rectangle Style="{StaticResource Hairline}" />
                                <DockPanel Style="{StaticResource SettingRow}">
                                    <TextBox
                                        Width="220"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="Checked by"
                                        DockPanel.Dock="Right"
                                        Style="{StaticResource Input.Text}"
                                        Text="{Binding Info.CheckedBy, UpdateSourceTrigger=PropertyChanged}" />
                                    <StackPanel Style="{StaticResource SettingText}">
                                        <TextBlock Style="{StaticResource Type.RowLabel}" Text="Checked by" />
                                    </StackPanel>
                                </DockPanel>
                                <Rectangle Style="{StaticResource Hairline}" />
                                <DockPanel Style="{StaticResource SettingRow}">
                                    <TextBox
                                        Width="120"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="Revision"
                                        DockPanel.Dock="Right"
                                        Style="{StaticResource Input.Text}"
                                        Text="{Binding Info.Revision, UpdateSourceTrigger=PropertyChanged}" />
                                    <StackPanel Style="{StaticResource SettingText}">
                                        <TextBlock Style="{StaticResource Type.RowLabel}" Text="Revision" />
                                    </StackPanel>
                                </DockPanel>
                                <Rectangle Style="{StaticResource Hairline}" />
                                <DockPanel Style="{StaticResource SettingRow}">
                                    <StackPanel
                                        VerticalAlignment="Center"
                                        DockPanel.Dock="Right"
                                        Orientation="Horizontal">
                                        <Button
                                            Margin="0,0,4,0"
                                            Click="BrowseLogo_Click"
                                            Style="{StaticResource Button.Plain}"
                                            ToolTip="PNG or JPEG drawn on the cover">
                                            Choose…
                                        </Button>
                                        <Button
                                            Click="ClearLogo_Click"
                                            Style="{StaticResource Button.Plain}"
                                            Visibility="{Binding LogoPath, Converter={StaticResource NotEmptyToVis}}">
                                            Remove
                                        </Button>
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource SettingText}">
                                        <TextBlock Style="{StaticResource Type.RowLabel}" Text="Logo" />
                                        <TextBlock
                                            Style="{StaticResource Type.RowHint}"
                                            Text="{Binding LogoPath}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DockPanel>
                                <Rectangle Style="{StaticResource Hairline}" />
                                <StackPanel Margin="14,8,8,10">
                                    <TextBlock Style="{StaticResource Type.RowLabel}" Text="Description" />
                                    <TextBox
                                        Margin="0,6,0,0"
                                        AutomationProperties.Name="Description"
                                        Style="{StaticResource Input.MultiLine}"
                                        Text="{Binding Info.Description, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource Type.GroupTitle}" Text="Contents" />
                <Border Padding="0,6" Style="{StaticResource Card}">
                    <StackPanel>
                                <CheckBox
                                    Margin="14,6,8,6"
                                    IsChecked="{Binding Options.IncludeCover}"
                                    Style="{StaticResource Input.Check}">
                                    <TextBlock Text="Cover page" TextWrapping="Wrap" />
                                </CheckBox>
                                <CheckBox
                                    Margin="14,6,8,6"
                                    IsChecked="{Binding Options.IncludeContents}"
                                    Style="{StaticResource Input.Check}">
                                    <TextBlock Text="Contents" TextWrapping="Wrap" />
                                </CheckBox>
                                <CheckBox
                                    Margin="14,6,8,6"
                                    IsChecked="{Binding Options.IncludeSummary}"
                                    Style="{StaticResource Input.Check}">
                                    <TextBlock Text="Summary of all rooms" TextWrapping="Wrap" />
                                </CheckBox>
                                <CheckBox
                                    Margin="14,6,8,6"
                                    IsChecked="{Binding Options.IncludeInputs}"
                                    Style="{StaticResource Input.Check}">
                                    <TextBlock Text="Inputs (grid, environment, bands)" TextWrapping="Wrap" />
                                </CheckBox>
                                <CheckBox
                                    Margin="14,6,8,6"
                                    IsChecked="{Binding Options.IncludeWalls}"
                                    Style="{StaticResource Input.Check}">
                                    <TextBlock Text="Walls" TextWrapping="Wrap" />
                                </CheckBox>
                                <CheckBox
                                    Margin="14,6,8,6"
                                    IsChecked="{Binding Options.IncludeSpeakers}"
                                    Style="{StaticResource Input.Check}">
                                    <TextBlock Text="Speaker types" TextWrapping="Wrap" />
                                </CheckBox>
                                <CheckBox
                                    Margin="14,6,8,6"
                                    IsChecked="{Binding Options.IncludeSpeakerInstances}"
                                    Style="{StaticResource Input.Check}">
                                    <TextBlock Text="Speaker positions table" TextWrapping="Wrap" />
                                </CheckBox>
                                <CheckBox
                                    Margin="14,6,8,6"
                                    IsChecked="{Binding Options.IncludeRoomDetails}"
                                    Style="{StaticResource Input.Check}">
                                    <TextBlock Text="Room details (statistics, STI distribution, criteria check)" TextWrapping="Wrap" />
                                </CheckBox>
                                <CheckBox
                                    Margin="14,6,8,6"
                                    IsChecked="{Binding Options.IncludeValueCharts}"
                                    Style="{StaticResource Input.Check}">
                                    <TextBlock Text="Value charts (numbers on the grid, per room)" TextWrapping="Wrap" />
                                </CheckBox>
                                <CheckBox
                                    Margin="14,6,8,6"
                                    IsChecked="{Binding Options.IncludeSpeakerContributions}"
                                    Style="{StaticResource Input.Check}"
                                    ToolTip="Each speaker's level at the room centre: one extra model run per speaker">
                                    <TextBlock Text="Speaker contributions per room" TextWrapping="Wrap" />
                                </CheckBox>
                                <CheckBox
                                    Margin="14,6,8,6"
                                    IsChecked="{Binding Options.IncludeCriteria}"
                                    Style="{StaticResource Input.Check}">
                                    <TextBlock Text="Criteria" TextWrapping="Wrap" />
                                </CheckBox>
                                <CheckBox
                                    Margin="14,6,8,6"
                                    IsChecked="{Binding Options.IncludeMethod}"
                                    Style="{StaticResource Input.Check}">
                                    <TextBlock Text="Calculation method" TextWrapping="Wrap" />
                                </CheckBox>
                                <CheckBox
                                    Margin="14,6,8,6"
                                    IsChecked="{Binding Options.ShowIsolines}"
                                    Style="{StaticResource Input.Check}">
                                    <TextBlock Text="Contour lines on the plans" TextWrapping="Wrap" />
                                </CheckBox>
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource Type.GroupTitle}" Text="Quantities" />
                <Border Padding="14,8,8,10" Style="{StaticResource Card}">
                    <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="72" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Grid.Column="1"
                            HorizontalAlignment="Center"
                            Style="{StaticResource Type.Caption}"
                            Text="Tables, CSV"
                            ToolTip="Summary, room statistics and the CSV files" />
                        <TextBlock
                            Grid.Column="2"
                            HorizontalAlignment="Center"
                            Style="{StaticResource Type.Caption}"
                            Text="Plans"
                            ToolTip="A coloured plan of each area" />
                        <TextBlock
                            Grid.Column="3"
                            HorizontalAlignment="Center"
                            Style="{StaticResource Type.Caption}"
                            Text="Value charts"
                            ToolTip="The number at every grid point, per room" />
                        <TextBlock
                            Grid.Row="1"
                            VerticalAlignment="Center"
                            Style="{StaticResource Type.RowLabel}"
                            Text="Sound level SPL (dB)" />
                        <CheckBox
                            Grid.Row="1"
                            Grid.Column="1"
                            HorizontalAlignment="Center"
                            AutomationProperties.Name="Sound level SPL (dB) in tables"
                            IsChecked="{Binding TableSpl}"
                            Style="{StaticResource Input.Check}" />
                        <CheckBox
                            Grid.Row="1"
                            Grid.Column="2"
                            HorizontalAlignment="Center"
                            AutomationProperties.Name="Sound level SPL (dB) plans"
                            IsChecked="{Binding PlanSpl}"
                            Style="{StaticResource Input.Check}" />
                        <CheckBox
                            Grid.Row="1"
                            Grid.Column="3"
                            HorizontalAlignment="Center"
                            AutomationProperties.Name="Sound level SPL (dB) value charts"
                            IsChecked="{Binding ChartSpl}"
                            Style="{StaticResource Input.Check}" />
                        <TextBlock
                            Grid.Row="2"
                            VerticalAlignment="Center"
                            Style="{StaticResource Type.RowLabel}"
                            Text="A-weighted level (dBA)" />
                        <CheckBox
                            Grid.Row="2"
                            Grid.Column="1"
                            HorizontalAlignment="Center"
                            AutomationProperties.Name="A-weighted level (dBA) in tables"
                            IsChecked="{Binding TableSplA}"
                            Style="{StaticResource Input.Check}" />
                        <CheckBox
                            Grid.Row="2"
                            Grid.Column="2"
                            HorizontalAlignment="Center"
                            AutomationProperties.Name="A-weighted level (dBA) plans"
                            IsChecked="{Binding PlanSplA}"
                            Style="{StaticResource Input.Check}" />
                        <CheckBox
                            Grid.Row="2"
                            Grid.Column="3"
                            HorizontalAlignment="Center"
                            AutomationProperties.Name="A-weighted level (dBA) value charts"
                            IsChecked="{Binding ChartSplA}"
                            Style="{StaticResource Input.Check}" />
                        <TextBlock
                            Grid.Row="3"
                            VerticalAlignment="Center"
                            Style="{StaticResource Type.RowLabel}"
                            Text="Speech intelligibility STI" />
                        <CheckBox
                            Grid.Row="3"
                            Grid.Column="1"
                            HorizontalAlignment="Center"
                            AutomationProperties.Name="Speech intelligibility STI in tables"
                            IsChecked="{Binding TableSti}"
                            Style="{StaticResource Input.Check}" />
                        <CheckBox
                            Grid.Row="3"
                            Grid.Column="2"
                            HorizontalAlignment="Center"
                            AutomationProperties.Name="Speech intelligibility STI plans"
                            IsChecked="{Binding PlanSti}"
                            Style="{StaticResource Input.Check}" />
                        <CheckBox
                            Grid.Row="3"
                            Grid.Column="3"
                            HorizontalAlignment="Center"
                            AutomationProperties.Name="Speech intelligibility STI value charts"
                            IsChecked="{Binding ChartSti}"
                            Style="{StaticResource Input.Check}" />
                        <TextBlock
                            Grid.Row="4"
                            VerticalAlignment="Center"
                            Style="{StaticResource Type.RowLabel}"
                            Text="Clarity C80 (and D50)" />
                        <CheckBox
                            Grid.Row="4"
                            Grid.Column="1"
                            HorizontalAlignment="Center"
                            AutomationProperties.Name="Clarity C80 (and D50) in tables"
                            IsChecked="{Binding TableC80}"
                            Style="{StaticResource Input.Check}" />
                        <CheckBox
                            Grid.Row="4"
                            Grid.Column="2"
                            HorizontalAlignment="Center"
                            AutomationProperties.Name="Clarity C80 (and D50) plans"
                            IsChecked="{Binding PlanC80}"
                            Style="{StaticResource Input.Check}" />
                        <CheckBox
                            Grid.Row="4"
                            Grid.Column="3"
                            HorizontalAlignment="Center"
                            AutomationProperties.Name="Clarity C80 (and D50) value charts"
                            IsChecked="{Binding ChartC80}"
                            Style="{StaticResource Input.Check}" />
                        <TextBlock
                            Grid.Row="5"
                            VerticalAlignment="Center"
                            Style="{StaticResource Type.RowLabel}"
                            Text="Octave bands 125 Hz – 8 kHz" />
                        <CheckBox
                            Grid.Row="5"
                            Grid.Column="1"
                            HorizontalAlignment="Center"
                            AutomationProperties.Name="Octave bands 125 Hz – 8 kHz in tables"
                            IsChecked="{Binding TableBands}"
                            Style="{StaticResource Input.Check}" />
                    </Grid>
                    <TextBlock
                        Margin="0,6,0,0"
                        Style="{StaticResource Type.RowHint}"
                        Text="Criteria are checked whatever is chosen here."
                        TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource Type.GroupTitle}" Text="Criteria" />
                <Border Padding="0,2" Style="{StaticResource Card}">
                    <StackPanel>
                                <DockPanel Style="{StaticResource SettingRow}">
                                    <StackPanel
                                        VerticalAlignment="Center"
                                        DockPanel.Dock="Right"
                                        Orientation="Horizontal">
                                        <TextBox
                                            AutomationProperties.Name="STI at every point"
                                            IsEnabled="{Binding Criteria.CheckStiMin}"
                                            Style="{StaticResource Input.Number}"
                                            Text="{Binding Criteria.StiMin, UpdateSourceTrigger=LostFocus, StringFormat=0.00}" />
                                        <TextBlock Style="{StaticResource Type.Unit}" Text="" />
                                    </StackPanel>
                                    <CheckBox
                                        VerticalAlignment="Center"
                                        IsChecked="{Binding Criteria.CheckStiMin}"
                                        Style="{StaticResource Input.Check}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Type.RowLabel}" Text="STI at every point" />
                                            <TextBlock Style="{StaticResource Type.RowHint}" Text="Lowest STI allowed anywhere in a room" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </CheckBox>
                                </DockPanel>
                                <Rectangle Style="{StaticResource Hairline}" />
                                <DockPanel Style="{StaticResource SettingRow}">
                                    <StackPanel
                                        VerticalAlignment="Center"
                                        DockPanel.Dock="Right"
                                        Orientation="Horizontal">
                                        <TextBox
                                            AutomationProperties.Name="Room average STI"
                                            IsEnabled="{Binding Criteria.CheckStiMean}"
                                            Style="{StaticResource Input.Number}"
                                            Text="{Binding Criteria.StiMeanMin, UpdateSourceTrigger=LostFocus, StringFormat=0.00}" />
                                        <TextBlock Style="{StaticResource Type.Unit}" Text="" />
                                    </StackPanel>
                                    <CheckBox
                                        VerticalAlignment="Center"
                                        IsChecked="{Binding Criteria.CheckStiMean}"
                                        Style="{StaticResource Input.Check}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Type.RowLabel}" Text="Room average STI" />
                                            <TextBlock Style="{StaticResource Type.RowHint}" Text="Lowest room-average STI" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </CheckBox>
                                </DockPanel>
                                <Rectangle Style="{StaticResource Hairline}" />
                                <DockPanel Style="{StaticResource SettingRow}">
                                    <StackPanel
                                        VerticalAlignment="Center"
                                        DockPanel.Dock="Right"
                                        Orientation="Horizontal">
                                        <TextBox
                                            AutomationProperties.Name="SPL variation"
                                            IsEnabled="{Binding Criteria.CheckSplSpread}"
                                            Style="{StaticResource Input.Number}"
                                            Text="{Binding Criteria.SplSpreadMaxDb, UpdateSourceTrigger=LostFocus}" />
                                        <TextBlock Style="{StaticResource Type.Unit}" Text="dB" />
                                    </StackPanel>
                                    <CheckBox
                                        VerticalAlignment="Center"
                                        IsChecked="{Binding Criteria.CheckSplSpread}"
                                        Style="{StaticResource Input.Check}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Type.RowLabel}" Text="SPL variation" />
                                            <TextBlock Style="{StaticResource Type.RowHint}" Text="Largest max − min SPL within a room" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </CheckBox>
                                </DockPanel>
                                <Rectangle Style="{StaticResource Hairline}" />
                                <DockPanel Style="{StaticResource SettingRow}">
                                    <StackPanel
                                        VerticalAlignment="Center"
                                        DockPanel.Dock="Right"
                                        Orientation="Horizontal">
                                        <TextBox
                                            AutomationProperties.Name="Sound level"
                                            IsEnabled="{Binding Criteria.CheckSplMinA}"
                                            Style="{StaticResource Input.Number}"
                                            Text="{Binding Criteria.SplMinDbA, UpdateSourceTrigger=LostFocus}" />
                                        <TextBlock Style="{StaticResource Type.Unit}" Text="dBA" />
                                    </StackPanel>
                                    <CheckBox
                                        VerticalAlignment="Center"
                                        IsChecked="{Binding Criteria.CheckSplMinA}"
                                        Style="{StaticResource Input.Check}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Type.RowLabel}" Text="Sound level" />
                                            <TextBlock Style="{StaticResource Type.RowHint}" Text="Lowest A-weighted level anywhere" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </CheckBox>
                                </DockPanel>
                                <Rectangle Style="{StaticResource Hairline}" />
                                <DockPanel Style="{StaticResource SettingRow}">
                                    <StackPanel
                                        VerticalAlignment="Center"
                                        DockPanel.Dock="Right"
                                        Orientation="Horizontal">
                                        <TextBox
                                            AutomationProperties.Name="Signal to noise"
                                            IsEnabled="{Binding Criteria.CheckSignalToNoise}"
                                            Style="{StaticResource Input.Number}"
                                            Text="{Binding Criteria.SignalToNoiseMinDb, UpdateSourceTrigger=LostFocus}" />
                                        <TextBlock Style="{StaticResource Type.Unit}" Text="dB" />
                                    </StackPanel>
                                    <CheckBox
                                        VerticalAlignment="Center"
                                        IsChecked="{Binding Criteria.CheckSignalToNoise}"
                                        Style="{StaticResource Input.Check}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Type.RowLabel}" Text="Signal to noise" />
                                            <TextBlock Style="{StaticResource Type.RowHint}" Text="Lowest margin over the background noise" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </CheckBox>
                                </DockPanel>
                                <Rectangle Style="{StaticResource Hairline}" />
                                <DockPanel Style="{StaticResource SettingRow}">
                                    <StackPanel
                                        VerticalAlignment="Center"
                                        DockPanel.Dock="Right"
                                        Orientation="Horizontal">
                                        <TextBox
                                            AutomationProperties.Name="Share of points"
                                            Style="{StaticResource Input.Number}"
                                            Text="{Binding PointCoveragePercent, UpdateSourceTrigger=LostFocus}" />
                                        <TextBlock Style="{StaticResource Type.Unit}" Text="%" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource SettingText}">
                                        <TextBlock Style="{StaticResource Type.RowLabel}" Text="Share of points" />
                                        <TextBlock
                                            Style="{StaticResource Type.RowHint}"
                                            Text="Points that must meet the point criteria (100 % = every point; 90 % ignores the worst tenth)"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </DockPanel>
                                <Rectangle Style="{StaticResource Hairline}" />
                                <CheckBox
                                    Margin="14,8,8,8"
                                    IsChecked="{Binding Criteria.SkipRoomsWithoutSpeakers}"
                                    Style="{StaticResource Input.Check}"
                                    ToolTip="Sound arriving from the next room is not a design target">
                                    <TextBlock Text="Do not assess rooms without speakers" TextWrapping="Wrap" />
                                </CheckBox>
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource Type.GroupTitle}" Text="Page" />
                <Border Padding="0,2" Style="{StaticResource Card}">
                    <StackPanel>
                                <DockPanel Style="{StaticResource SettingRow}">
                                    <Border
                                        VerticalAlignment="Center"
                                        DockPanel.Dock="Right"
                                        Style="{StaticResource Segmented}">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton
                                                Content="English"
                                                GroupName="ReportLanguage"
                                                IsChecked="{Binding LanguageEnglish, Mode=TwoWay}"
                                                Style="{StaticResource Segment}" />
                                            <RadioButton
                                                Content="Eesti"
                                                GroupName="ReportLanguage"
                                                IsChecked="{Binding LanguageEstonian, Mode=TwoWay}"
                                                Style="{StaticResource Segment}" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource Type.RowLabel}" Text="Language" />
                                </DockPanel>
                                <Rectangle Style="{StaticResource Hairline}" />
                                <DockPanel Style="{StaticResource SettingRow}">
                                    <Border
                                        VerticalAlignment="Center"
                                        DockPanel.Dock="Right"
                                        Style="{StaticResource Segmented}">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton
                                                Content="A4"
                                                GroupName="ReportPaper"
                                                IsChecked="{Binding PageA4, Mode=TwoWay}"
                                                Style="{StaticResource Segment}" />
                                            <RadioButton
                                                Content="A3"
                                                GroupName="ReportPaper"
                                                IsChecked="{Binding PageA3, Mode=TwoWay}"
                                                Style="{StaticResource Segment}" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource Type.RowLabel}" Text="Paper" />
                                </DockPanel>
                                <Rectangle Style="{StaticResource Hairline}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!--  ================= Preview =================  -->
        <DockPanel Grid.Row="1" Grid.Column="4">
            <DockPanel Margin="0,0,0,8" DockPanel.Dock="Top">
                <StackPanel
                    VerticalAlignment="Center"
                    DockPanel.Dock="Right"
                    Orientation="Horizontal">
                    <Button
                        AutomationProperties.Name="Previous page"
                        Click="PrevPage_Click"
                        Style="{StaticResource Button.Icon}"
                        ToolTip="Previous page (Page Up)">
                        <materialDesign:PackIcon Width="18" Height="18" Kind="ChevronLeft" />
                    </Button>
                    <TextBlock
                        MinWidth="90"
                        VerticalAlignment="Center"
                        Style="{StaticResource Type.Secondary}"
                        Text="{Binding PageLabel}"
                        TextAlignment="Center" />
                    <Button
                        AutomationProperties.Name="Next page"
                        Click="NextPage_Click"
                        Style="{StaticResource Button.Icon}"
                        ToolTip="Next page (Page Down)">
                        <materialDesign:PackIcon Width="18" Height="18" Kind="ChevronRight" />
                    </Button>
                </StackPanel>
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource Type.GroupTitle}"
                    Text="Preview" />
                <TextBlock
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource Type.Caption}"
                    Text="Updating…"
                    Visibility="{Binding IsBuilding, Converter={StaticResource BoolToVis}}" />
            </DockPanel>
            <Border x:Name="PreviewFrame" Style="{StaticResource Surface}">
                <Grid>
                    <skia:SKElement
                        x:Name="PreviewCanvas"
                        MouseWheel="PreviewCanvas_MouseWheel"
                        PaintSurface="PreviewCanvas_PaintSurface" />
                    <TextBlock
                        Margin="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Style="{StaticResource Type.Secondary}"
                        Text="{Binding PreviewError}"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        Visibility="{Binding PreviewError, Converter={StaticResource NotEmptyToVis}}" />
                </Grid>
            </Border>
        </DockPanel>

        <!--  ================= Save =================  -->
        <DockPanel
            Grid.Row="2"
            Grid.ColumnSpan="5"
            Margin="0,14,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button
                    Margin="0,0,8,0"
                    Click="Close_Click"
                    IsCancel="True"
                    Style="{StaticResource Button.Secondary}">
                    Close
                </Button>
                <Button
                    Click="SavePdf_Click"
                    IsEnabled="{Binding CanExport}"
                    Style="{StaticResource Button.Primary}"
                    ToolTip="Choose where to save the PDF">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FilePdfBox" Style="{StaticResource ButtonIconLabel}" />
                        <TextBlock Text="Save PDF…" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <CheckBox
                x:Name="CsvCheck"
                VerticalAlignment="Center"
                Style="{StaticResource Input.Check}"
                ToolTip="Also write the room summary and every grid value as CSV next to the PDF (opens in Excel)">
                <TextBlock Text="Also save CSV tables" />
            </CheckBox>
            <Button
                x:Name="OpenButton"
                Margin="16,0,0,0"
                VerticalAlignment="Center"
                Click="OpenPdf_Click"
                Style="{StaticResource Button.Plain}"
                Visibility="Collapsed">
                Open
            </Button>
            <TextBlock
                x:Name="ExportStatus"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Style="{StaticResource Type.Secondary}"
                TextTrimming="CharacterEllipsis" />
        </DockPanel>
    </Grid>
</Window>
