<UserControl x:Class="SoundCalcs.UI.AcousticViewerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF">
    <!--  Styles and palette come from the window (SoundCalcsStyles + the active theme).  -->
    <Grid Background="{DynamicResource Viewer.CanvasBrush}">

        <!-- GPU-composited Skia surface: heatmap + walls + speakers -->
        <skia:SKElement x:Name="SkCanvas"
                        AutomationProperties.Name="Plan viewer"
                        PaintSurface="OnPaintSurface"
                        MouseWheel="Canvas_MouseWheel"
                        MouseDown="Canvas_MouseDown"
                        MouseMove="Canvas_MouseMove"
                        MouseUp="Canvas_MouseUp"
                        Cursor="Hand"
                        Focusable="True"/>

        <!--  Viewer tools: one floating bar, top left (the legend is drawn top right)  -->
        <Border Margin="10"
                Padding="3"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Style="{DynamicResource Floating}">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="FitBtn"
                        AutomationProperties.Name="Fit to view"
                        Click="FitBtn_Click"
                        Cursor="Arrow"
                        Style="{DynamicResource ViewerTool}"
                        ToolTip="Fit the plan to the view">
                    <materialDesign:PackIcon Width="16" Height="16" Kind="FitToScreenOutline" />
                </Button>
                <Button x:Name="ProbeBtn"
                        AutomationProperties.Name="Probe"
                        Click="ProbeBtn_Click"
                        Cursor="Arrow"
                        Style="{DynamicResource ViewerTool}"
                        ToolTip="Probe: click the plan to pin a reading">
                    <materialDesign:PackIcon Width="16" Height="16" Kind="CrosshairsGps" />
                </Button>
                <Button x:Name="ClearPinsBtn"
                        AutomationProperties.Name="Clear probe pins"
                        Click="ClearPinsBtn_Click"
                        Cursor="Arrow"
                        Style="{DynamicResource ViewerTool}"
                        ToolTip="Remove all probe pins"
                        Visibility="Collapsed">
                    <materialDesign:PackIcon Width="16" Height="16" Kind="PinOffOutline" />
                </Button>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
